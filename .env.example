OPENROUTER_API_KEY=
GROQ_API_KEY=
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=


DB_HOST=localhost
DB_PORT=5432
DB_NAME=company_intel

DB_GENERAL_USER=general_role
DB_GENERAL_PASSWORD=general_dev_password

DB_ELEVATED_USER=app_owner
DB_ELEVATED_PASSWORD=devpassword

CHECKPOINT_BACKEND=postgres
DATABASE_URL=postgresql://app_owner:devpassword@localhost:5432/company_intel
CHAINLIT_DATABASE_URL=postgresql+asyncpg://app_owner:devpassword@localhost:5432/company_intel

# Connection pool (defaults shown; tune per deployment)
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE_GENERAL=5
DB_POOL_MAX_SIZE_ELEVATED=3
DB_POOL_ACQUIRE_TIMEOUT=30
DB_CONNECT_TIMEOUT=5

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Directory for persisted Chainlit element files (chart images)
CHART_STORAGE_DIR=.chainlit_charts

DEFAULT_USER_ID=test-user-1
DEFAULT_THREAD_ID=thread-test-user-3
DEFAULT_PERMISSION_LEVEL=general

# run  chainlit create-secret to generate the secret

CHAINLIT_AUTH_SECRET= 